# ─────────────────────────────────────────────
# TrustShield AI - Frontend Environment Variables
# ─────────────────────────────────────────────

# Backend API Base URL
# - In local development: leave blank. Vite automatically proxies `/api` to http://127.0.0.1:8000
# - In same-origin production (e.g. reverse proxy): leave blank. Requests use relative `/api`
# - In cross-origin production (e.g. Vercel frontend + Render backend):
#   Set to your live backend URL (e.g. https://trustshield-api.onrender.com/api)
VITE_API_URL=

