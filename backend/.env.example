# ─────────────────────────────────────────────
# TrustShield AI - Environment Variables
# ─────────────────────────────────────────────

# Application Environment (development | production)
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# AI Providers (Optional - leave empty for rule-based demo mode)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Safe Browsing API (Optional)
# If provided, enables external threat matches verification alongside structural analysis
GOOGLE_SAFE_BROWSING_API_KEY=
# Bounded timeout in seconds for Safe Browsing API requests (default: 5.0)
SAFE_BROWSING_TIMEOUT_SECONDS=5.0

# Security & Authentication (Required - Minimum 32 characters / 256 bits)
# Never use a placeholder or commit a real secret to source control!
# Generate a cryptographically secure random key using:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Email / SMTP Configuration (Secure Password Reset Flow)
# When configured, password reset tokens and links are dispatched via SMTP.
# In local development when left blank, tokens are NOT exposed in API responses or public logs;
# instead, reset links are safely recorded in backend/.dev_mailbox.json for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@trustshield.ai
SMTP_TLS=true

# Database (Optional - defaults to local SQLite if empty)
# SQLite default: sqlite:///./trustshield.db
# PostgreSQL: postgresql://user:password@localhost:5432/trustshield_ai
DATABASE_URL=sqlite:///./trustshield.db

# App Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_MESSAGE_LENGTH=5000
MAX_URL_LENGTH=2048
MAX_SCREENSHOT_SIZE_MB=5

# Community Report Attachments
# Directory where report screenshots are stored (must be outside the frontend tree)
# Default: backend/uploads/reports/
COMMUNITY_UPLOAD_DIR=
# Maximum size in MB for community report attachment uploads
MAX_COMMUNITY_ATTACHMENT_SIZE_MB=5
